# Injected variables from the Operator
agent-ops-ui-image=quay.io/opendatahub/odh-mod-arch-agent-ops:main
gateway-domain=

# ─── OpenShell gateway discovery ─────────────────────────────────────────────
# Find OpenShell gateways by asking the cluster: list Services carrying the
# OpenShell chart's label, and read each gateway's own ConfigMap for the OIDC
# issuer and audience it actually runs with. Those two must match what the
# gateway was started with, and configuring them here instead would make this a
# hand-kept copy of the gateway's Helm values — a copy nothing validates, whose
# drift surfaces only as a gateway refusal several hops away.
openshell-discovery=true

# The browser's OIDC public client id. This one genuinely cannot be discovered:
# the gateway's config carries issuer and audience only, because the gateway has
# no notion of a browser client. Per-gateway, set the
# openshell.opendatahub.io/client-id annotation on the gateway Service instead.
openshell-client-id=

# Label selector for gateway Services. Empty uses the OpenShell chart's own
# label (app.kubernetes.io/name=openshell).
openshell-gateway-selector=

# Comma-separated namespaces to search. Empty searches the whole cluster.
openshell-gateway-namespaces=

# Explicit gateway list, as a JSON array. Setting this DISABLES discovery and
# reintroduces the hand-copied issuer/audience — it exists for pinning an install
# the selector does not match, and for pointing at a gateway outside the cluster.
# Example:
#   openshell-gateways=[{"id":"prod","name":"Production","gatewayUrl":"openshell.openshell.svc.cluster.local:8080","issuer":"https://dex.example/","clientId":"openshell-dashboard","audience":"openshell-dashboard"}]
openshell-gateways=
