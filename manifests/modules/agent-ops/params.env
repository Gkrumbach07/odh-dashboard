# Injected variables from the Operator
agent-ops-ui-image=quay.io/opendatahub/odh-mod-arch-agent-ops:main
gateway-domain=

# OpenShell installs to route to, as a JSON array. One install is one gateway.
# Example:
#   openshell-gateways=[{"id":"prod","name":"Production","bffUrl":"https://openshell-dashboard.openshell.svc.cluster.local:8443"}]
openshell-gateways=
