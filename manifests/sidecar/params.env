# Injected variables from the Operator
model-registry-ui-image=quay.io/opendatahub/odh-mod-arch-modular-architecture:main

gen-ai-ui-image=quay.io/opendatahub/odh-mod-arch-gen-ai:main
pgvector-image=registry.redhat.io/rhel9/postgresql-16

maas-ui-image=quay.io/opendatahub/mod-arch-maas:main

mlflow-ui-image=quay.io/opendatahub/odh-mod-arch-mlflow:main

eval-hub-ui-image=quay.io/opendatahub/odh-mod-arch-eval-hub:main

automl-ui-image=quay.io/opendatahub/odh-mod-arch-automl:main
automl-pipeline-runtime-image=

autorag-ui-image=quay.io/opendatahub/odh-mod-arch-autorag:main
autorag-pipeline-runtime-image=

agent-ops-ui-image=quay.io/opendatahub/odh-mod-arch-agent-ops:main

# ─── OpenShell gateway discovery ─────────────────────────────────────────────
# Find OpenShell gateways by asking the cluster: list Services carrying the
# OpenShell chart's label, and read each gateway's own ConfigMap for the OIDC
# issuer and audience it actually runs with. Configuring those here instead
# would make this a hand-kept copy of the gateway's Helm values, whose drift
# surfaces only as a gateway refusal several hops away.
openshell-discovery=true

# The browser's OIDC public client id. This one cannot be discovered: the
# gateway's config carries issuer and audience only. Per-gateway, set the
# openshell.opendatahub.io/client-id annotation on the gateway Service.
openshell-client-id=

# Label selector for gateway Services. Empty uses the OpenShell chart's label.
openshell-gateway-selector=

# Comma-separated namespaces to search. Empty searches the whole cluster.
openshell-gateway-namespaces=

# Explicit gateway list, as a JSON array. Setting this DISABLES discovery.
# Example:
#   openshell-gateways=[{"id":"prod","name":"Production","gatewayUrl":"openshell.openshell.svc.cluster.local:8080","issuer":"https://dex.example/","clientId":"openshell-dashboard","audience":"openshell-dashboard"}]
openshell-gateways=
